# Copia este archivo a .env.local y completa los valores reales.

# Cadena de conexión a Postgres. En Vercel se agrega sola al conectar el
# storage de Postgres del proyecto (Storage → Create Database).
POSTGRES_URL=postgres://usuario:clave@localhost:5432/regmarcajes

# String aleatorio largo para firmar la cookie de sesión — generar una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En local puede omitirse (se genera uno automáticamente en .data/session.secret);
# en Vercel es obligatorio definirlo a mano.
SESSION_SECRET=
